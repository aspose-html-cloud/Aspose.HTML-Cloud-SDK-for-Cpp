# Copy to signing.local.env (gitignored) and fill in. Used by sign.ps1 / sign.bat.
# Values may also be supplied as environment variables (they take precedence).
SSLCOM_USERNAME=
SSLCOM_PASSWORD=
SSLCOM_CREDENTIAL_ID=
SSLCOM_TOTP_SECRET=
# Used only for `nuget push` (see docs/publish-nuget.md)
NUGET_API_KEY=
